SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_ANON_KEY=replace-with-publishable-or-legacy-anon-key

# Webhook verification
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-random-secret

# Protects scheduled/manual worker invocations
WORKER_SECRET=replace-with-at-least-32-random-characters

# Local testing only. Never enable in production.
ALLOW_TEST_WEBHOOKS=false
